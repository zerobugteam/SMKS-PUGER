  String get _pageTitle {
    switch (_selectedIndex) {
      case 1:
        return 'Absensi';
      case 2:
        return 'Nilai Semester';
      case 3:
        return 'Jadwal Pelajaran';
      case 4:
        return 'Pendaftaran Magang';
      case 5:
        return 'Pelaksanaan Magang';
      case 6:
        return 'Biaya SPP';
      case 7:
        return 'Daftar Ulang';
      case 8:
        return 'Panduan Siswa';
      case 9:
        return 'Ganti Sandi';
      default:
        return 'SMKS Puger';
    }
  }

  void _logout() {
    Navigator.of(context).pushAndRemoveUntil(
      MaterialPageRoute(builder: (_) => const LoginPage()),
      (route) => false,
    );
  }

  void _copyText(String label, String value) {
    Clipboard.setData(ClipboardData(text: value));
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text('$label ($value) disalin.'),
        duration: const Duration(seconds: 1),
      ),
    );
  }

  Widget _buildActivePage(bool isWide) {
    switch (_selectedIndex) {
      case 1:
        return AbsensiPage();
      case 2:
        return const NilaiSemesterPage();
      case 3:
        return JadwalPelajaranPage();
      case 4:
        return const MagangPage(key: ValueKey('pendaftaran'), initialTab: 1);
      case 5:
        return const MagangPage(key: ValueKey('pelaksanaan'), initialTab: 0);
      case 6:
        return const DaftarUlangPage(key: ValueKey('biaya_spp'), initialTab: 0);
      case 7:
        return const DaftarUlangPage(
          key: ValueKey('daftar_ulang'),
          initialTab: 1,
        );
      case 8:
        return const PanduanSiswaPage();
      case 9:
        return const GantiSandiPage();
      default:
        return _fastDashboardList(isWide);
    }
  }

