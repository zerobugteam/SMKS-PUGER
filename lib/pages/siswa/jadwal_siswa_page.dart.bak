                            fontSize: 15,
                            fontWeight: FontWeight.w800,
                            color: Colors.white,
                          ),
                        ),
                        Text(
                          'Portal Siswa',
                          style: TextStyle(
                            fontSize: 12,
                            color: Color(0xFFCBD5E1),
                          ),
                        ),
                      ],
                    ),
                  ),
                ],
              ),
            ),
            Expanded(
              child: ListView(
                padding: const EdgeInsets.symmetric(vertical: 8),
                children: [
                  _drawerTile(
                    index: 0,
                    icon: Icons.dashboard_rounded,
                    title: 'Dashboard',
                  ),
                  _drawerTile(
                    index: 1,
                    icon: Icons.location_on_outlined,
                    title: 'Absensi',
                  ),
                  _drawerTile(
                    index: 2,
                    icon: Icons.grade_outlined,
                    title: 'Nilai Semester',
                  ),
                  _drawerTile(
                    index: 3,
                    icon: Icons.calendar_month_outlined,
                    title: 'Jadwal Pelajaran',
                  ),

                  // 1. Sub-menu Magang / PKL
                  Theme(
                    data: Theme.of(context)
                        .copyWith(dividerColor: Colors.transparent),
                    child: ExpansionTile(
                      initiallyExpanded: isMagangSelected,
                      leading: Icon(
                        Icons.work_outline_rounded,
                        color: isMagangSelected
                            ? AppColors.primary
                            : AppColors.muted,
                      ),
                      title: Text(
                        'Magang / PKL',
                        style: TextStyle(
                          fontSize: 14,
                          fontWeight: isMagangSelected
                              ? FontWeight.w700
                              : FontWeight.w600,
                          color: isMagangSelected
                              ? AppColors.primary
                              : AppColors.text,
                        ),
                      ),
                      childrenPadding: const EdgeInsets.only(left: 20),
                      children: [
                        _drawerTile(
                          index: 4,
                          icon: Icons.app_registration_rounded,
                          title: 'Pendaftaran Magang',
                          isSubMenu: true,
                        ),
                        _drawerTile(
                          index: 5,
                          icon: Icons.assignment_turned_in_outlined,
                          title: 'Pelaksanaan Magang',
                          isSubMenu: true,
                        ),
                      ],
                    ),
                  ),

                  // 2. Sub-menu Pembiayaan & Daftar Ulang (Biaya SPP & Daftar Ulang)
                  Theme(
                    data: Theme.of(context)
                        .copyWith(dividerColor: Colors.transparent),
                    child: ExpansionTile(
                      initiallyExpanded: isPembiayaanSelected,
                      leading: Icon(
                        Icons.account_balance_wallet_outlined,
                        color: isPembiayaanSelected
                            ? AppColors.primary
                            : AppColors.muted,
